{
  "info": {
    "name": "Barber Appointment API",
    "description": "Coding Factory 9 final project.\n\nIntegration tests for the barber booking API.\n\nHow to use:\n1. Start the backend (`./gradlew bootRun`).\n2. Run **Auth > Authenticate as barber** or **as customer** — the token is captured into the `token` collection variable automatically, and every later request reuses it.\n3. Run the folders in order, or use Collection Runner on the whole collection.\n\nRequests that create something store the new uuid into a collection variable, so the follow-up requests need no copy-and-paste.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "serviceUuid", "value": "" },
    { "key": "appointmentUuid", "value": "" },
    { "key": "promotionUuid", "value": "" },
    { "key": "slotStart", "value": "" },
    { "key": "bookingDate", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Authenticate as barber",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns a token', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "pm.test('role is ADMIN', () => pm.expect(body.user.role).to.eql('ADMIN'));",
                  "pm.test('carries admin capabilities', () => {",
                  "    pm.expect(body.user.capabilities).to.include('MANAGE_SERVICES');",
                  "    pm.expect(body.user.capabilities).to.include('VIEW_APPOINTMENTS');",
                  "});",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"barber\",\n  \"password\": \"barber12345\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/authenticate", "host": ["{{baseUrl}}"], "path": ["auth", "authenticate"] }
          }
        },
        {
          "name": "Authenticate as customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('role is CUSTOMER', () => pm.expect(body.user.role).to.eql('CUSTOMER'));",
                  "pm.test('cannot manage services', () =>",
                  "    pm.expect(body.user.capabilities).to.not.include('MANAGE_SERVICES'));",
                  "pm.test('can book', () =>",
                  "    pm.expect(body.user.capabilities).to.include('BOOK_APPOINTMENT'));",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer\",\n  \"password\": \"customer12345\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/authenticate", "host": ["{{baseUrl}}"], "path": ["auth", "authenticate"] }
          }
        },
        {
          "name": "Authenticate with bad credentials (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('does not reveal which field was wrong', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql('INVALID_CREDENTIALS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"barber\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/authenticate", "host": ["{{baseUrl}}"], "path": ["auth", "authenticate"] }
          }
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "Get shop profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK without a token', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has a shop name', () => pm.expect(body.shopName).to.be.a('string'));",
                  "pm.test('lists services', () => pm.expect(body.services).to.be.an('array').that.is.not.empty);",
                  "pm.test('lists opening hours', () => pm.expect(body.workingHours).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/barber/profile", "host": ["{{baseUrl}}"], "path": ["barber", "profile"] }
          }
        },
        {
          "name": "List services",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const services = pm.response.json();",
                  "pm.test('returns the catalogue', () => pm.expect(services).to.be.an('array').that.is.not.empty);",
                  "pm.test('every service has a positive duration', () =>",
                  "    services.forEach(s => pm.expect(s.durationMinutes).to.be.above(0)));",
                  "",
                  "// Prefer a service with a live promotion so the discount path gets exercised.",
                  "const promo = services.find(s => s.promotionalPrice !== null);",
                  "const chosen = promo ?? services[0];",
                  "pm.collectionVariables.set('serviceUuid', chosen.uuid);",
                  "",
                  "if (promo) {",
                  "    pm.test('promotional price is lower than the list price', () =>",
                  "        pm.expect(Number(promo.promotionalPrice)).to.be.below(Number(promo.price)));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/services", "host": ["{{baseUrl}}"], "path": ["services"] }
          }
        },
        {
          "name": "List active promotions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const promos = pm.response.json();",
                  "pm.test('returns an array', () => pm.expect(promos).to.be.an('array'));",
                  "pm.test('every promotion is live today', () => {",
                  "    const today = new Date().toISOString().slice(0, 10);",
                  "    promos.forEach(p => {",
                  "        pm.expect(p.validFrom <= today).to.be.true;",
                  "        pm.expect(p.validTo >= today).to.be.true;",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/promotions/active", "host": ["{{baseUrl}}"], "path": ["promotions", "active"] }
          }
        }
      ]
    },
    {
      "name": "Availability",
      "item": [
        {
          "name": "Find the next open day with a free slot",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The seeded shop is closed on Sunday and Monday, so start from",
                  "// tomorrow and let the test step forward until it finds a slot.",
                  "if (!pm.collectionVariables.get('bookingDate')) {",
                  "    const d = new Date();",
                  "    d.setDate(d.getDate() + 1);",
                  "    pm.collectionVariables.set('bookingDate', d.toISOString().slice(0, 10));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK without a token', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "",
                  "if (body.closed || body.slots.length === 0) {",
                  "    // Step to the next day and run this request again.",
                  "    const next = new Date(pm.collectionVariables.get('bookingDate'));",
                  "    next.setDate(next.getDate() + 1);",
                  "    pm.collectionVariables.set('bookingDate', next.toISOString().slice(0, 10));",
                  "    pm.execution.setNextRequest('Find the next open day with a free slot');",
                  "} else {",
                  "    pm.test('slots are within the day and ordered', () => {",
                  "        const starts = body.slots.map(s => s.startTime);",
                  "        pm.expect(starts).to.eql([...starts].sort());",
                  "    });",
                  "    pm.test('each slot lasts exactly the service duration', () => {",
                  "        const toMin = t => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };",
                  "        body.slots.forEach(s =>",
                  "            pm.expect(toMin(s.endTime) - toMin(s.startTime)).to.eql(body.durationMinutes));",
                  "    });",
                  "    pm.collectionVariables.set('slotStart', body.slots[0].startTime);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/availability?serviceUuid={{serviceUuid}}&date={{bookingDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["availability"],
              "query": [
                { "key": "serviceUuid", "value": "{{serviceUuid}}" },
                { "key": "date", "value": "{{bookingDate}}" }
              ]
            }
          }
        },
        {
          "name": "Availability in the past (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('explains why', () =>",
                  "    pm.expect(pm.response.json().description.toLowerCase()).to.include('past'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/availability?serviceUuid={{serviceUuid}}&date=2020-01-01",
              "host": ["{{baseUrl}}"],
              "path": ["availability"],
              "query": [
                { "key": "serviceUuid", "value": "{{serviceUuid}}" },
                { "key": "date", "value": "2020-01-01" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Booking (as customer)",
      "item": [
        {
          "name": "Log in as customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer\",\n  \"password\": \"customer12345\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/authenticate", "host": ["{{baseUrl}}"], "path": ["auth", "authenticate"] }
          }
        },
        {
          "name": "Book the slot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('returns a Location header', () =>",
                  "    pm.expect(pm.response.headers.get('Location')).to.be.a('string'));",
                  "const body = pm.response.json();",
                  "pm.test('starts as PENDING', () => pm.expect(body.status).to.eql('PENDING'));",
                  "pm.test('the server computed the end time', () =>",
                  "    pm.expect(new Date(body.endAt) - new Date(body.startAt)).to.eql(body.durationMinutes * 60000));",
                  "pm.test('the server priced it', () =>",
                  "    pm.expect(Number(body.priceCharged)).to.be.at.least(0));",
                  "pm.collectionVariables.set('appointmentUuid', body.uuid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceUuid\": \"{{serviceUuid}}\",\n  \"startAt\": \"{{bookingDate}}T{{slotStart}}\",\n  \"notes\": \"Booked from the Postman collection\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] }
          }
        },
        {
          "name": "Book the same slot again (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict - the slot is taken', () => pm.response.to.have.status(409));",
                  "pm.test('says the slot is gone', () =>",
                  "    pm.expect(pm.response.json().code).to.include('SlotUnavailable'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceUuid\": \"{{serviceUuid}}\",\n  \"startAt\": \"{{bookingDate}}T{{slotStart}}\",\n  \"notes\": \"Duplicate booking attempt\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] }
          }
        },
        {
          "name": "Book an off-grid time (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict - 09:07 was never offered', () => pm.response.to.have.status(409));",
                  "pm.test('explains it is not an offered time', () =>",
                  "    pm.expect(pm.response.json().description).to.include('not an offered time'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceUuid\": \"{{serviceUuid}}\",\n  \"startAt\": \"{{bookingDate}}T09:07:00\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] }
          }
        },
        {
          "name": "List my appointments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('is a page', () => pm.expect(page).to.have.property('content'));",
                  "pm.test('includes the booking just made', () =>",
                  "    pm.expect(page.content.map(a => a.uuid))",
                  "      .to.include(pm.collectionVariables.get('appointmentUuid')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/appointments/me", "host": ["{{baseUrl}}"], "path": ["appointments", "me"] }
          }
        },
        {
          "name": "Browse the whole diary (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden - a customer may not read the diary', () =>",
                  "    pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] }
          }
        },
        {
          "name": "Create a service as customer (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden - MANAGE_SERVICES is required', () =>",
                  "    pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should not be created\",\n  \"durationMinutes\": 30,\n  \"price\": 1.00\n}"
            },
            "url": { "raw": "{{baseUrl}}/services", "host": ["{{baseUrl}}"], "path": ["services"] }
          }
        }
      ]
    },
    {
      "name": "Diary (as barber)",
      "item": [
        {
          "name": "Log in as barber",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"barber\",\n  \"password\": \"barber12345\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/authenticate", "host": ["{{baseUrl}}"], "path": ["auth", "authenticate"] }
          }
        },
        {
          "name": "Browse the diary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('is paginated', () => {",
                  "    pm.expect(page).to.have.property('content');",
                  "    pm.expect(page).to.have.property('totalElements');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/appointments?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["appointments"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Filter the diary by status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('every row matches the filter', () =>",
                  "    pm.response.json().content.forEach(a => pm.expect(a.status).to.eql('PENDING')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/appointments?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["appointments"],
              "query": [{ "key": "status", "value": "PENDING" }]
            }
          }
        },
        {
          "name": "Confirm the appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('now CONFIRMED', () =>",
                  "    pm.expect(pm.response.json().status).to.eql('CONFIRMED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentUuid}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "{{appointmentUuid}}", "status"]
            }
          }
        },
        {
          "name": "Illegal transition back to PENDING (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request - not a legal move', () => pm.response.to.have.status(400));",
                  "pm.test('names the transition', () =>",
                  "    pm.expect(pm.response.json().description).to.include('CONFIRMED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"PENDING\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentUuid}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "{{appointmentUuid}}", "status"]
            }
          }
        },
        {
          "name": "Cancel the appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('now CANCELLED', () =>",
                  "    pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentUuid}}",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "{{appointmentUuid}}"]
            }
          }
        },
        {
          "name": "The cancelled slot is free again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('the cancelled time is on offer once more', () => {",
                  "    const slots = pm.response.json().slots.map(s => s.startTime);",
                  "    pm.expect(slots).to.include(pm.collectionVariables.get('slotStart'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/availability?serviceUuid={{serviceUuid}}&date={{bookingDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["availability"],
              "query": [
                { "key": "serviceUuid", "value": "{{serviceUuid}}" },
                { "key": "date", "value": "{{bookingDate}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Administration (as barber)",
      "item": [
        {
          "name": "Create a service",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('is active by default', () => pm.expect(body.active).to.be.true);",
                  "pm.collectionVariables.set('createdServiceUuid', body.uuid);"
                ]
              }
            }
          ],
          "request": {
